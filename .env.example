# ── 서버 전용 (브라우저 번들에 절대 안 들어감) ──
# 로컬: 이 파일을 .env.local 로 복사해서 채운다. 배포: Vercel 프로젝트 환경변수에 넣는다.

# 방법 A. 공식 Instagram Graph API — Business Discovery (비즈니스/크리에이터 계정만 조회 가능, 조회수 없음)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# META_GRAPH_VERSION=v23.0

# 방법 B. Apify Instagram Scraper (공개 계정이면 개인 계정도 가능, 조회수 포함, 유료 사용량)
APIFY_TOKEN=

# 한 번에 가져올 최대 게시물 수 (기본 150)
# MAX_POSTS=150

# 배포 API를 남이 쓰지 못하게 막는 암호 (선택. 넣으면 화면에서도 암호가 필요)
# APP_PASSCODE=

# CORS 허용 주소 (기본: https://bberry0648-dotcom.github.io)
# ALLOWED_ORIGINS=
